### 2) `.env.example`
```ini
# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN

# Potok API
POTOK_API_TOKEN=f2bb08aeb769d005c4eec29a1d329999
POTOK_API_BASE_URL=https://app.potok.io/api/v3

# AI/LLM
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=google/gemini-2.5-flash-preview-05-20

# Database
DATABASE_URL=sqlite+aiosqlite:///hr_agent.db

# Timezone
TIMEZONE=Europe/Moscow

# Admin logic
DEFAULT_ADMIN_ID=975902763

# Environment
ENV=development
